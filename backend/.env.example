ENVIRONMENT=development
# DATABASE_URL omitted: defaults to backend/ielts_mock.db.
# For PostgreSQL set DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Production requires a random secret of at least 32 characters.
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=uploads
CONTENT_AUDIO_DIR=content_audio
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
MAX_UPLOAD_SIZE_BYTES=26214400
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TRANSCRIPTION_MODEL=whisper-1
AI_DAILY_REQUEST_LIMIT=100
AI_MAX_OUTPUT_TOKENS=1600
