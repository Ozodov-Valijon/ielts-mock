ENVIRONMENT=development
# Local development: bu qiymatni qoldirishingiz yoki PostgreSQL URL berishingiz mumkin.
DATABASE_URL=sqlite:///./ielts_mock.db
# Productionda kamida 32 belgidan iborat, tasodifiy maxfiy kalitni kiriting.
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
UPLOAD_DIR=uploads
FRONTEND_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=26214400
